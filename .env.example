# Supabase project connection (safe for browser use with RLS enabled)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only administrative access. Never prefix this with NEXT_PUBLIC.
# Leave blank until a trusted server-only feature actually requires it.
SUPABASE_SECRET_KEY=

# Server-only key used to encrypt GoHighLevel PIT credentials at rest.
# Use a long random value (at least 24 characters). Never prefix with NEXT_PUBLIC.
GHL_ENCRYPTION_KEY=
